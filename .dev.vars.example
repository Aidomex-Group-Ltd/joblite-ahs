# Development environment variables for Wrangler
# Copy to .dev.vars and populate with secure values
# Use scripts/setup-dev-secrets.sh to generate automatically

SESSION_SECRET=REPLACE_WITH_SESSION_SECRET
CSRF_SECRET=REPLACE_WITH_CSRF_SECRET

# Optional bearer token for POST /api/v1/admin/sync (local initial sync and
# operations). Keep it server-side; never expose it to the frontend.
INGEST_TOKEN=REPLACE_WITH_RANDOM_TOKEN

# Optional: Stream and email configuration. For local email delivery, use a
# Resend API key and a sender identity whose domain is verified in Resend.
# STREAM_ACCOUNT_ID=
# STREAM_API_TOKEN=
# RESEND_API_KEY=
# EMAIL_FROM="Joblite <noreply@your-verified-domain.example>"
# EMAIL_API_KEY=  # Legacy alias; RESEND_API_KEY is preferred.

# Optional DeepSeek support-chat inference. The model ID is not a credential.
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL_ID=deepseek-chat
