# Joblite AHS Environment Variables
ENVIRONMENT=development
APP_URL=http://localhost:8787
SESSION_SECRET=replace-with-secure-random-string
CSRF_SECRET=replace-with-secure-random-string
# Optional admin bearer token for POST /api/v1/admin/sync. Server-side only.
INGEST_TOKEN=replace-with-secure-random-string

# Cloudflare bindings are configured in wrangler.toml
# D1: DB binding
# R2: MEDIA binding  
# Queues: OUTBOX_QUEUE, INGEST_QUEUE
# Stream: STREAM_ACCOUNT_ID, STREAM_API_TOKEN (optional - feature disabled if missing)
# Email: EMAIL_API_KEY (optional - auth delivery must be configured for production)
